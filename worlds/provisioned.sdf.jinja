<?xml version="1.0" ?>
<!--
  Provisioned Gazebo Harmonic world template (P0-B, OWN mode).

  Rendered by gazebo_mcp.bridge.world_provisioner.WorldProvisioner using
  string.Template substitution (no jinja2 dependency required):
    $world_name  -> world name
    $step_size   -> physics max_step_size (seconds)
    $rtf         -> physics real_time_factor
    $models      -> rendered <include> blocks from the model manifest

  Plugin filenames are the Gazebo Sim 8 (Harmonic) "gz-sim-*-system" names.
  PosePublisher publishes entity poses to /world/<name>/pose/info, which the
  ros_gz_bridge maps to tf2_msgs/msg/TFMessage for the Modern adapter's
  pose-readback path.

  P1 ACTUATION (WRITE-ONLY this session; live-verify deferred):
  - A JointPositionController (gz-sim-joint-position-controller-system) is
    injected per *revolute* joint of each model in the manifest, listening on
    /model/<m>/joint/<j>/cmd_pos. Continuous joints are skipped (no positional
    target). The static example block below documents the exact plugin form for
    the JETANK arm; when the JETANK SDF lands and the WorldProvisioner is
    extended to substitute a $joint_controllers slot per manifest model, this
    static block is replaced by the generated set. Until then it is inert
    documentation co-located with the world it provisions.
  - EntityWrench commands arrive on /world/<name>/wrench (and clears on
    /world/<name>/wrench/clear). In Harmonic gz-sim 8 these topics are serviced
    by the DEDICATED ApplyLinkWrench system (gz-sim-apply-link-wrench-system /
    gz::sim::systems::ApplyLinkWrench), loaded below — NOT by UserCommands.
    Topic-applied wrenches are persistent-until-cleared (the caller must publish
    to .../wrench/clear); the EntityWrench topic does not honor a duration.
-->
<sdf version="1.9">
  <world name="$world_name">
    <physics name="provisioned_physics" type="ignored">
      <max_step_size>$step_size</max_step_size>
      <real_time_factor>$rtf</real_time_factor>
    </physics>

    <!-- Core Harmonic system plugins -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- Services /world/<name>/wrench (+ /wrench/clear): applies the
         EntityWrench published by the Modern adapter to the named entity's
         link. Topic-applied wrenches are persistent-until-cleared. -->
    <plugin
      filename="gz-sim-apply-link-wrench-system"
      name="gz::sim::systems::ApplyLinkWrench">
    </plugin>

    <!-- Publishes entity poses to /world/<name>/pose/info -->
    <plugin
      filename="gz-sim-pose-publisher-system"
      name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_model_pose>true</publish_model_pose>
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>60</update_frequency>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Models from the manifest (rendered <include> blocks; empty if none) -->
$models

    <!-- ===================================================================
         P1 actuation: per-joint JointPositionController (WRITE-ONLY example).
         One block per *revolute* joint of the JETANK arm (manifest model
         "jetank"); continuous joints (arm_base_to_arm_bearing_joint) omitted.
         Each controller subscribes to /model/jetank/joint/<j>/cmd_pos
         (std_msgs/Float64 after the ros_gz bridge). The launch file bridges
         those topics. Inert until the JETANK SDF + provisioner substitution
         land; documents the exact Harmonic plugin form for live-verify.
         =================================================================== -->
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>chassis_to_arm_bearing_joint</joint_name>
      <topic>/model/jetank/joint/chassis_to_arm_bearing_joint/cmd_pos</topic>
      <p_gain>10.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.5</d_gain>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>arm_base_to_camera_joint</joint_name>
      <topic>/model/jetank/joint/arm_base_to_camera_joint/cmd_pos</topic>
      <p_gain>10.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.5</d_gain>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>arm_base_to_long_joint</joint_name>
      <topic>/model/jetank/joint/arm_base_to_long_joint/cmd_pos</topic>
      <p_gain>10.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.5</d_gain>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>arm_long_to_short_joint</joint_name>
      <topic>/model/jetank/joint/arm_long_to_short_joint/cmd_pos</topic>
      <p_gain>10.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.5</d_gain>
    </plugin>

  </world>
</sdf>
